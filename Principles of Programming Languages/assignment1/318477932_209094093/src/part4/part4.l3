;--- Question 4.1 ---

; Signature: append(l1, l2)
; Type: [List(T1) * List(T2) -> List(T1 ∪ T2)]
; Purpose: combine two lists together.
; Pre-conditions: true
; Tests: (append '(1 2) '(3 4)) -> '(1 2 3 4)
(define append
    (lambda (l1 l2)
        ; if the 1st list is empty, return the 2nd
        (if (eq? l1 '()) 
        l2
        ; else, cons the 1st element of l1 with the result of appending the rest of l1 with l2
        (cons (car l1) (append (cdr l1) l2))) 
))

;--- Question 4.2 ---

; Signature: reverse(lst)
; Type: [List(T) -> List(T)]
; Purpose: Reverses a list.
; Pre-conditions: true
; Tests: (reverse '(1 2 3)) -> '(3 2 1)
(define reverse
    (lambda (l)
    ; if l is empty - return it empty
    (if(eq? l '())
      l
      ; else, append the reverse of the rest of the list with a list with the 1st element of l
      (append (reverse (cdr l)) (cons (car l) '())))
))

;--- Question 4.3 ---


; Signature: duplicate-items(lst, dup-count)
; Type: [List(T) * List(Number) -> List(T)]
; Purpose: Duplicates each item in the first list according to the numbers defined in the same position in the second list, treating the second list cyclically if it's shorter than the first.
; Pre-conditions: (not (?eq dup-count '()))
; Tests: (duplicate-items '(1 2 3) '(1 0)) -> '(1 3)
;        (duplicate-items '(1 2 3) '(2 1 0 10 2)) -> '(1 1 2)
(define duplicate-items
  (lambda (lst dup-count)
  ;if lst is empty, return empty list
    (if (eq? lst '())                      
      '()
       ;Cons a list madde by element-to-list with the curr element in lst and its matching count in dup-count
      (append (element-to-list (car lst) (car dup-count))(duplicate-items (cdr lst)
        (append(cdr dup-count) 
                    (cons (car dup-count) '())))))
                    ;Cycle dup-count by appending its cdr with its car and consing it with empty list
))


; Signature: element-to-list(element, count)
; Type: [T * Number -> List(T)]
; Purpose: Generates list with the given value repeated the specified num of times.
; Pre-conditions: The number of times must be >= 0. 
; Tests: (element-to-list 1 3) -> '(1 1 1)
;        (element-to-list 'a 0) -> '()
(define element-to-list  
  (lambda (element count)
  ;if count is not positive, return an empty list
    (if (<= count 0)
      '()
      ;else, cons ekement with the result of :recursively calling element-to-list with element and decreased count
      (cons element (element-to-list element (- count 1))))
))



; Test cases
(display "Testing append: ")
(display (append '(1 2) '(3 4))) (newline)

(display "Testing reverse: ")
(display (reverse '(1 2 3))) (newline)

(display "Testing element-to-list: ")
(display (element-to-list 1 3)) (newline)
(display (element-to-list 'a 0)) (newline)

(display "Testing duplicate-items: ")
(display (duplicate-items '(1 2 3) '(1 0))) (newline)
(display (duplicate-items '(1 2 3) '(2 1 0 10 2))) (newline)
(display (duplicate-items '() '(2 1))) (newline)